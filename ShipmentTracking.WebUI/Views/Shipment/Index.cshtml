@model List<ShipmentTracking.Entities.DTOs.Shipment.ShipmentListDto>

@{
    ViewData["Title"] = "Kargo Listesi";
}

<div class="container mt-5">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary fw-bold">📦 Kargo Takip Sistemi</h2>
        <a asp-action="Create" class="btn btn-success shadow-sm">+ Yeni Kargo Ekle</a>
    </div>

    <div class="card shadow border-0">
        <div class="card-body p-0">
            <table class="table table-hover table-striped mb-0">
                <thead class="table-primary text-white">
                    <tr>
                        <th>#ID</th>
                        <th>Takip Numarası</th>
                        <th>Gönderici</th>
                        <th>Alıcı</th>
                        <th>Durum</th>
                        <th>Oluşturulma Tarihi</th>
                        <th class="text-center">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td><strong>@item.Id</strong></td>
                                <td><span class="badge bg-secondary">@item.TrackingNumber</span></td>
                                <td>@item.SenderName</td>
                                <td>@item.ReceiverName</td>
                                <td>
                                    <span class="badge @(item.Status == "Hazırlanıyor" ? "bg-warning text-dark" : "bg-info")">
                                        @item.Status
                                    </span>
                                </td>
                                <td>@item.CreatedDate.ToString("dd.MM.yyyy HH:mm")</td>
                                <td class="text-center">
                                    <a asp-action="Detail" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-1">Detay</a>
                                    <a asp-action="Update" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning me-1">Düzenle</a>
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Bu kargoyu silmek istediğine emin misin?');" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">Sistemde henüz kayıtlı kargo bulunamadı.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>