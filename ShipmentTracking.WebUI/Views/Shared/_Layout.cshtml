<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ShipmentTracking.WebUI</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ShipmentTracking.WebUI.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
    
                <ul class="navbar-nav flex-grow-1">
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Ana Sayfa (Kargo Sorgula)</a>
                    </li>
                </ul>

                <ul class="navbar-nav ms-auto align-items-center">
        
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <!-- 1. Herkesin Gördüğü Kargo Yönetimi -->
                        <li class="nav-item me-3">
                            <a class="nav-link text-primary fw-bold" asp-controller="Shipment" asp-action="Index">
                                📦 Kargoları Yönet
                            </a>
                        </li>

                        <!-- 2. İŞTE BİZİM VIP KAPI (SADECE ADMİN) -->
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item me-2">
                                <a class="btn btn-outline-info btn-sm fw-bold" asp-controller="Auth" asp-action="PersonnelList">
                                    <i class="bi bi-people-fill"></i> Personel Yönetimi
                                </a>
                            </li>
                        }

                        <!-- 3. Kullanıcı Adı Gösterimi -->
                        <li class="nav-item me-3">
                            <span class="text-muted">
                                Hoş geldin, <strong>@User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value</strong>
                            </span>
                        </li>

                        <!-- 4. Çıkış Butonu -->
                        <li class="nav-item">
                            <a class="btn btn-outline-danger btn-sm" asp-controller="Auth" asp-action="Logout">
                                Çıkış Yap
                            </a>
                        </li>
                    }
                    else
                    {
                        <!-- Giriş Yapmamış Kişiler -->
                        <li class="nav-item">
                            <a class="btn btn-outline-secondary btn-sm" asp-controller="Auth" asp-action="Login">
                                Personel Girişi
                            </a>
                        </li>
                    }
        
                </ul>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - KargoTakip.AŞ - <a asp-area="" asp-controller="Home" asp-action="Privacy">Gizlilik Sözleşmesi</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    @if (TempData["Success"] != null)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function() {
            Swal.fire({
            toast: true,
            position: 'top-end',
            icon: 'success',
            title: '@TempData["Success"]',
            showConfirmButton: false,
            timer: 3000, // 3 saniye sonra kaybolur
            timerProgressBar: true
            });
            });
        </script>
    }

    @if (TempData["Error"] != null)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function() {
            Swal.fire({
            toast: true,
            position: 'top-end',
            icon: 'error',
            title: '@TempData["Error"]',
            showConfirmButton: false,
            timer: 4000,
            timerProgressBar: true
            });
            });
        </script>
    }
</body>
</html>