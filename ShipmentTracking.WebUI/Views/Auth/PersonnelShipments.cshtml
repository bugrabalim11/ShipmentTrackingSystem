@model List<ShipmentTracking.Entities.DTOs.Shipment.ShipmentListDto>

@{
    ViewData["Title"] = "Personel İşlem Geçmişi";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary fw-bold">
            <i class="bi bi-box-seam me-2"></i> @ViewBag.PersonnelName - İşlem Geçmişi
        </h2>
        <a asp-action="PersonnelList" class="btn btn-secondary shadow-sm">
            <i class="bi bi-arrow-left me-1"></i> Listeye Dön
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover table-striped mb-0 text-center align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>Takip No</th>
                                <th>Gönderici</th>
                                <th>Alıcı</th>
                                <th>Durum</th>
                                <th>Eklenme Tarihi</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="fw-bold">
                                        <span class="badge bg-secondary">@item.TrackingNumber</span>
                                    </td>
                                    <td>@item.SenderName</td>
                                    <td>@item.ReceiverName</td>
                                    <td>
                                        <span class="badge bg-info text-dark px-3 py-2 rounded-pill">
                                            @item.Status
                                        </span>
                                    </td>
                                    <td>@item.CreatedDate.ToString("dd.MM.yyyy HH:mm")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-warning text-center m-4 mb-4 shadow-sm border-0">
                    <i class="bi bi-exclamation-circle-fill me-2"></i> Bu personele ait henüz kayıtlı bir kargo işlemi bulunamadı.
                </div>
            }
        </div>
    </div>
</div>